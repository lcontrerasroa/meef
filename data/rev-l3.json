            "ˈdut̬i"
          ],
          "show": "/ˈduːt̬i/",
          "feedback": "Yod-dropping après /d/ et T-voicing (attaque post-accentuelle, intervocalique)."
        },
        {
          "type": "text",
          "keyboard": "narrow",
          "prompt": "<span class=\"big\">chancellor</span> : SSBE <span class=\"ipa\">/ˈtʃɑːnsələ/</span>",
