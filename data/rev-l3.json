    {
      "title": "1. De SSBE vers GA",
      "instructions": "On vous donne la transcription SSBE. Tapez la transcription GA. La longueur ː est acceptée ou non pour le GA, <span class=\"ipa\">ɚ</span> = <span class=\"ipa\">ər</span>.",
      "items": [
        {
          "type": "text",
          "keyboard": "narrow",
          "prompt": "<span class=\"big\">sorcerer</span> : SSBE <span class=\"ipa\">/ˈsɔːsərə/</span>",
          "audio": {
            "src": "https://upload.wikimedia.org/wikipedia/commons/a/a9/En-us-sorcerer.ogg",
            "label": "GA"
          },
          "accept": [
            "ˈsɔːrsərər",
            "ˈsɔrsərər"
          ],
          "show": "/ˈsɔːrsərər/",
          "feedback": "Rhoticité : trois ‹r›, trois /r/ en GA, dont deux en coda."
        },
        {
          "type": "text",
          "keyboard": "narrow",
          "prompt": "<span class=\"big\">duty</span> : SSBE <span class=\"ipa\">/ˈdjuːti/</span>",
