    {
      "title": "2. T-voicing en GA : oui ou non ?",
      "instructions": "Le ‹t› souligné est-il réalisé <span class=\"ipa\">[t̬]</span> en GA ?",
      "items": [
        {
          "type": "qcm",
          "prompt": "pho<u>t</u>ocopy",
          "options": [
            "oui",
            "non"
          ],
          "answer": 0,
          "feedback": "<span class=\"ipa\">[ˈfoʊt̬əkɑːpi]</span> : attaque post-accentuelle, après voyelle.",
          "audio": {
